{
  "model_name": "WildfireEarlyDetectionImpact",
  "version": "1.0",
  "description": "Physics-based model combining elliptical fire spread with escape threshold probability",
  "data_source": "BDIFF (Base de Données Incendies Forêts France) 2025",
  "fire_records": 21141,
  "total_area_burned_ha": 31744,
  "mathematical_model": {
    "spread_area_formula": "Area(t) = (π/2) × R_flank × (R_head + R_back) × t²",
    "escape_probability": "sigmoid(area_ha - threshold) where threshold ≈ 3 ha",
    "carbon_emissions": "Area × tCO2_per_ha(vegetation) [pine 69.8, mixed 55, garrigue 25, grassland 10]",
    "economic_value": "Area × (Suppression_Cost + Asset_Value)"
  },
